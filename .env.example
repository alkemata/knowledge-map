APP_ENV=production
PUBLIC_ORIGIN=https://map.alkemata.com
POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://knowledge:replace-with-url-encoded-password@db/knowledge
SESSION_SECRET=replace-with-at-least-32-random-bytes
ASSET_ROOT=/data/assets
TRUSTED_PROXY_CIDRS=172.16.0.0/12
ALLOWED_ORIGINS=https://map.alkemata.com
MCP_ENABLED=true
MCP_WRITE_ENABLED=false
OIDC_ISSUER=https://auth.alkemata.com/realms/alkemata
OIDC_BROWSER_CLIENT_ID=knowledge-map-browser
OIDC_BROWSER_CLIENT_SECRET=replace-with-keycloak-client-secret
OIDC_MCP_AUDIENCE=https://map.alkemata.com/mcp
OIDC_MCP_ENFORCE=false
WORDPRESS_STATS_TOKEN=replace-with-dedicated-random-token
BACKUP_TARGET=configure-protected-off-server-target
LOG_LEVEL=INFO
