APP_ENV=production
PUBLIC_ORIGIN=https://map.alkemata.com
POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://knowledge:replace-with-url-encoded-password@db/knowledge
SESSION_SECRET=replace-with-at-least-32-random-bytes
ASSET_ROOT=/data/assets
TRUSTED_PROXY_CIDRS=172.16.0.0/12
ALLOWED_ORIGINS=https://map.alkemata.com
MCP_ENABLED=true
MCP_WRITE_ENABLED=false
BACKUP_TARGET=configure-protected-off-server-target
LOG_LEVEL=INFO
